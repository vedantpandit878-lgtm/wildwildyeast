<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voice Agent setup"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Enable the accessibility service" />

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Grant permissions (mic, contacts, calls, SMS)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3. Choose the brain" />

        <RadioGroup
            android:id="@+id/brainGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/brainLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="On-device Gemini Nano: free, private, works offline" />

            <RadioButton
                android:id="@+id/brainClaude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Claude in the cloud: smarter, needs an API key, costs per use" />
        </RadioGroup>

        <TextView
            android:id="@+id/nanoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="On-device AI: checking..." />

        <Button
            android:id="@+id/btnDownloadNano"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Download on-device AI" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Claude API key (only for the cloud brain)" />

        <EditText
            android:id="@+id/apiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-ant-..."
            android:inputType="textPassword|textNoSuggestions" />

        <Button
            android:id="@+id/btnSaveKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save key" />

        <CheckBox
            android:id="@+id/messageBySms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Send plain 'message X' commands by SMS instead of WhatsApp" />

        <CheckBox
            android:id="@+id/confirmEverything"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ask before every tap (safe mode for testing)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="4. Test without speaking" />

        <EditText
            android:id="@+id/command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Open Gmail and read me the newest email subject"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run typed command" />

        <Button
            android:id="@+id/btnVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run voice command" />

        <Button
            android:id="@+id/btnForget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Forget all saved routines" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Once the service is enabled a small microphone bubble floats over every app. Tap it, speak, and watch. Tap it again to stop the agent at any time. The agent asks for confirmation before sending, paying, booking or deleting anything.\n\nBasics run instantly with no AI: call or text someone, WhatsApp a message, open an app, set an alarm or timer, remind me, navigate somewhere, play music, search the web, flashlight, volume, wifi, bluetooth, calendar, camera, time, date, battery, read the screen, lock, screenshot. Say &quot;what can you do&quot; to hear the list.\n\nAnything else is worked out on screen the first time, remembered, and replayed instantly after that."
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
